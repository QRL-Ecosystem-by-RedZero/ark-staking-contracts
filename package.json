{
  "name": "ark-staking-contracts",
  "version": "0.1.0",
  "description": "Ark Staking - the QRL leg in Hyperion, the origin-chain escrow in Solidity, and the relay between them",
  "license": "MIT",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor-oz.js",
    "compile": "node scripts/compile.js",
    "compile:evm": "node scripts/compile-evm.js",
    "build": "npm run vendor && npm run compile",
    "test": "node test/run.js",
    "test:evm": "node scripts/test-evm.js --suite contracts",
    "test:relay": "node scripts/test-evm.js --suite relay",
    "check:qrl": "npm run build && npm test",
    "check:evm": "npm run compile:evm && npm run test:evm && npm run test:relay",
    "check": "npm run check:qrl && npm run check:evm",
    "gas": "node scripts/gas.js",
    "flatten:contract": "node scripts/flatten.js",
    "flatten:contract:own": "node scripts/flatten.js --own",
    "flatten:ark-staking": "node scripts/flatten.js --repo --flat",
    "gen:deployer": "node scripts/gen-deployer.js",
    "net:up": "bash scripts/kurtosis-up.sh",
    "net:down": "bash scripts/kurtosis-down.sh",
    "net:bootstrap": "bash scripts/wsl-bootstrap.sh",
    "deploy": "node scripts/deploy.js",
    "deploy:evm": "node scripts/deploy-evm.js",
    "relay": "node ecdsa-stakings/relayer/bin/relay.js",
    "relay:status": "node ecdsa-stakings/relayer/bin/relay.js status",
    "deploy:inherited": "node scripts/deploy-inherited.js",
    "delegation:status": "node scripts/delegation-status.js",
    "delegation:vc": "bash scripts/delegation-vc.sh",
    "compile:testnet": "node scripts/compile.js --profile testnet",
    "compile:evm:testnet": "node scripts/compile-evm.js --profile testnet",
    "build:testnet": "npm run vendor && npm run compile:testnet && npm run compile:evm:testnet",
    "deploy:testnet": "node scripts/deploy-testnet.js",
    "deploy:governance": "node scripts/deploy-governance.js",
    "governance:accept": "node scripts/governance-accept.js",
    "vendor:governance": "node scripts/vendor-governance.js",
    "e2e": "node scripts/e2e.js",
    "invariants": "node scripts/invariants-watch.js",
    "court:sweep": "node scripts/court-sweep.js",
    "e2e:local": "node scripts/e2e-local.js",
    "seed:escrow": "node scripts/seed-escrow.js",
    "deploy:delegation": "node scripts/deploy-delegation.js",
    "book": "node scripts/book.js",
    "solver": "node ecdsa-stakings/relayer/bin/solver.js",
    "solver:check": "node ecdsa-stakings/relayer/bin/solver.js check",
    "solver:status": "node ecdsa-stakings/relayer/bin/solver.js status",
    "stress:fuzz": "node ecdsa-stakings/stress/leg-a-fuzz.js --form both --steps 600",
    "stress:fork": "node ecdsa-stakings/stress/steth-fork.js"
  },
  "dependencies": {
    "@openzeppelin/contracts": "4.9.6",
    "@theqrl/abi": "^1.0.3",
    "@theqrl/hypc": "^0.0.2",
    "@theqrl/wallet.js": "^6.3.0",
    "@theqrl/web3": "^1.0.3",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.2",
    "@ethereumjs/util": "^10.1.2",
    "@ethereumjs/vm": "^10.1.2",
    "ethereum-cryptography": "^3.2.0",
    "hardhat": "^2.29.1",
    "solc": "0.8.24"
  }
}
