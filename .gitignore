node_modules/
build/
abi/
deployments/*.json
tools/p*.hyp
.env
# Every other .env variant (backups before a redeploy, per-host copies) holds
# live secrets too; only the template is tracked (audit 2026-09-29, R3-05).
.env.*
!.env.example
.kurtosis/
txt/
txt-ark-staking/

# The origin-chain leg. `build/` and `abi/` above are unanchored patterns, so
# they already match ecdsa-stakings/<chain>/build/ and .../abi/ at any depth —
# that is relied on, not incidental.
ecdsa-stakings/*/state/
ecdsa-stakings/*/deployments/*-local.json

# Time-compressed builds (scripts/lib/profile.js), relayer state, e2e reports.
build-testnet/
build-rapid/
# v3 (QRVM) builds and ABIs from docker hypc:local, as the ecosystem repository ignores them.
build-qrvm/
build-qrvm-testnet/
build-qrvm-rapid/
abi-qrvm/
.relayer/
reports/
ecdsa-stakings/local/
ecdsa-stakings/local-*/
# rehearsal lanes, generated by scripts/rehearsal-lanes.js setup
ecdsa-stakings/rehearsal-v3-l*/
ecdsa-stakings/rehearsal-v3-g[0-9]*/

# Agent worktrees.
.claude/worktrees/
.relayer-backup/

# The ecosystem layer's governance artifacts, vendored for deployment (scripts/vendor-governance.js).
vendor/core-governance/

# Dev logs and agent memory stay local (removed from history 2026-10-02).
/CLAUDE.md
/docs/audit/
.claude/
