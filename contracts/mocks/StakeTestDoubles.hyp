/**
 * A sender on an IArkFlow lane, as the Quantum Ark Treasury and Qurrl's
 * revenue splitter send (`ArkFlowSend.push`): clamped to the receiver's room,
 * never reverting for the receiver's reasons, keeping whatever was not sent.
 * Test-only; the Cushion's suite drives the bond's lane through it.
 */
contract MockFlowSender {
    event Pushed(uint256 sent);

    function push(address receiver, bytes32 lane, bytes32 ref) external payable returns (uint256 sent) {
        sent = ArkFlowSend.push(receiver, lane, ref, msg.value);
        emit Pushed(sent);
    }

    receive() external payable {}
}
