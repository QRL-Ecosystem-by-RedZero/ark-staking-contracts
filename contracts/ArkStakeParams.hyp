    /* ------------------------------------------------------------------ */
    /* Ranges and relations                                                */
    /* ------------------------------------------------------------------ */

    /**
     * Every range and relation of whitepaper §6.3, on a whole set: the checks
     * run in `ArkStakeParamsChecks` by a static call of a fixed selector
     * (staking CLAUDE.md item 128), because with the Cushion's keys they no
     * longer fit here beside the rest under EIP-170 on the v3 line. They read
     * the set, passed by value, and the registry's widest asset exit, so
     * they need none of this contract's storage. A refusal there is
     * re-raised here byte for byte, so it reaches the caller with the error
     * and the arguments it had before the split.
     */
    function _check(address module, Params memory p, uint256 rows) private view {
        (bool ok, ) = module.staticcall(abi.encodeWithSelector(ArkStakeParamsChecks.check.selector, p, registry, rows));
        if (!ok) {
            /// @hyperion memory-safe-assembly
            assembly {
                let q := mload(0x40)
                returndatacopy(q, 0, returndatasize())
                revert(q, returndatasize())
            }
        }
    }
}
